#include "udf.hpp"
#include "RANSktau.hpp"
#ifdef NEKRS_ASCENT_ENABLED
#include "nekAscent.hpp"
#endif

#include <algorithm>
#include <array>
#include <cmath>
#include <fstream>
#include <iomanip>
#include <memory>
#include <vector>

#ifdef __okl__
void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    if (bc->id == p_inletBid1 || bc->id == p_inletBid2) {
      bc->uxFluid = p_uInf * cos(p_aoaRad);
      bc->uyFluid = p_uInf * sin(p_aoaRad);
      bc->uzFluid = 0.0;
    } else {
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = 0.0;
    }
    return;
  }

  if (isField("scalar k")) {
    if (bc->id == p_wallBid) {
      bc->sScalar = p_kWall;
    } else {
      bc->sScalar = p_kInlet;
    }
    return;
  }

  if (isField("scalar tau")) {
    if (bc->id == p_wallBid) {
      bc->sScalar = p_tauWall;
    } else {
      bc->sScalar = p_tauInlet;
    }
    return;
  }
}
#endif

namespace
{
constexpr dfloat PI = 3.14159265358979323846;

// Flow / reference settings
static dfloat UINF = 1.0;
static dfloat AOA_DEG = 11.0;
static dfloat AOA_RAD = 11.0 * PI / 180.0;
static dfloat RE = 400000.0;
static dfloat RHO = 1.0;
static dfloat REF_CHORD = 1.0;
static dfloat REF_SPAN = 0.0;
static dfloat REF_AREA = 1.0;

// Boundary IDs in the 7-entry boundary map
static int INLET_BID1 = 1;
static int INLET_BID2 = 4;
static int WALL_BID = 3;

// Turbulence BC/control
static dfloat TURB_INTENSITY = 0.01;
static dfloat EDDY_VISC_RATIO = 10.0;
static dfloat K_WALL = 0.0;
static dfloat TAU_WALL = 0.0;
static dfloat K_INLET = 1.0e-6;
static dfloat TAU_INLET = 0.1;

// Output control
static int FORCE_WRITE_EVERY = 1;
static int ASCENT_YAML_EVERY = 50;

static occa::memory o_wallBid;
#ifdef NEKRS_ASCENT_ENABLED
static deviceMemory<dfloat> o_qcriterion;
#endif

void userq(double /*time*/)
{
  RANSktau::updateSourceTerms();
}

void uservp(double /*time*/)
{
  RANSktau::updateProperties();
}

void computeInletKTau()
{
  // nu = U * c / Re  and  mu = rho * nu
  const dfloat nu = UINF * REF_CHORD / RE;
  const dfloat mu = RHO * nu;

  K_INLET = std::max<dfloat>(1.5 * (UINF * TURB_INTENSITY) * (UINF * TURB_INTENSITY), 1.0e-12);
  TAU_INLET = std::max<dfloat>(EDDY_VISC_RATIO * mu / (RHO * K_INLET), 1.0e-8);
}

void initializeForceFile()
{
  if (platform->comm.mpiRank() != 0) {
    return;
  }

  std::ofstream f("aero_forces.dat", std::ios::out);
  f << "# step time Fx Fy Fz Fpx Fpy Fpz Fvx Fvy Fvz Drag Lift Cd Cl\n";
  f.close();
}

void writeAeroForces(const double time, const int tstep)
{
  if (!o_wallBid.isInitialized()) {
    const std::vector<int> wallBid = {WALL_BID};
    o_wallBid = platform->device.malloc<int>(wallBid.size(), wallBid.data());
  }

  std::unique_ptr<AeroForce> force(nrs->aeroForces(o_wallBid));

  const auto fV = force->viscous();
  const auto fP = force->pressure();
  const std::array<dfloat, 3> fT = {fV[0] + fP[0], fV[1] + fP[1], fV[2] + fP[2]};

  const dfloat drag = fT[0] * std::cos(AOA_RAD) + fT[1] * std::sin(AOA_RAD);
  const dfloat lift = -fT[0] * std::sin(AOA_RAD) + fT[1] * std::cos(AOA_RAD);

  const dfloat qInf = 0.5 * RHO * UINF * UINF;
  const dfloat denom = std::max<dfloat>(qInf * REF_AREA, 1.0e-16);
  const dfloat cd = drag / denom;
  const dfloat cl = lift / denom;

  if (platform->comm.mpiRank() == 0) {
    std::ofstream f("aero_forces.dat", std::ios::app);
    f << tstep << " " << std::scientific << std::setprecision(12) << time << " " << fT[0] << " " << fT[1]
      << " " << fT[2] << " " << fP[0] << " " << fP[1] << " " << fP[2] << " " << fV[0] << " " << fV[1]
      << " " << fV[2] << " " << drag << " " << lift << " " << cd << " " << cl << "\n";
    f.close();

    printf("step=%d time=%e Drag=%e Lift=%e Cd=%e Cl=%e\n", tstep, time, drag, lift, cd, cl);
  }
}

} // namespace

void UDF_LoadKernels(deviceKernelProperties &kernelInfo)
{
  kernelInfo.define("p_uInf") = UINF;
  kernelInfo.define("p_aoaRad") = AOA_RAD;
  kernelInfo.define("p_inletBid1") = INLET_BID1;
  kernelInfo.define("p_inletBid2") = INLET_BID2;
  kernelInfo.define("p_wallBid") = WALL_BID;
  kernelInfo.define("p_kInlet") = K_INLET;
  kernelInfo.define("p_tauInlet") = TAU_INLET;
  kernelInfo.define("p_kWall") = K_WALL;
  kernelInfo.define("p_tauWall") = TAU_WALL;
}

void UDF_Setup0(MPI_Comm /*comm*/, setupAide & /*options*/)
{
  platform->par->extract("casedata", "U_inf", UINF);
  platform->par->extract("casedata", "AoA", AOA_DEG);
  platform->par->extract("casedata", "Re", RE);
  platform->par->extract("casedata", "rho", RHO);
  platform->par->extract("casedata", "refChord", REF_CHORD);
  platform->par->extract("casedata", "refSpan", REF_SPAN);

  platform->par->extract("casedata", "inletBid1", INLET_BID1);
  platform->par->extract("casedata", "inletBid2", INLET_BID2);
  platform->par->extract("casedata", "wallBid", WALL_BID);

  platform->par->extract("casedata", "turbulenceIntensity", TURB_INTENSITY);
  platform->par->extract("casedata", "eddyViscosityRatio", EDDY_VISC_RATIO);
  platform->par->extract("casedata", "kWall", K_WALL);
  platform->par->extract("casedata", "tauWall", TAU_WALL);

  platform->par->extract("casedata", "forceWriteIntervalSteps", FORCE_WRITE_EVERY);
  platform->par->extract("casedata", "processAscentYamlFrequency", ASCENT_YAML_EVERY);

  AOA_RAD = AOA_DEG * PI / 180.0;
  FORCE_WRITE_EVERY = std::max(FORCE_WRITE_EVERY, 1);
  ASCENT_YAML_EVERY = std::max(ASCENT_YAML_EVERY, 0);

  computeInletKTau();
}

void UDF_Setup()
{
  nrs->userSource = &userq;
  nrs->userProperties = &uservp;

  auto *mesh = nrs->meshV;

  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    std::vector<dfloat> U(mesh->dim * nrs->fluid->fieldOffset, 0.0);
    std::vector<dfloat> k(mesh->Nlocal, K_INLET);
    std::vector<dfloat> tau(mesh->Nlocal, TAU_INLET);

    const dfloat ux = UINF * std::cos(AOA_RAD);
    const dfloat uy = UINF * std::sin(AOA_RAD);

    for (int n = 0; n < mesh->Nlocal; ++n) {
      U[n + 0 * nrs->fluid->fieldOffset] = ux;
      U[n + 1 * nrs->fluid->fieldOffset] = uy;
      U[n + 2 * nrs->fluid->fieldOffset] = 0.0;
    }

    nrs->fluid->o_solution().copyFrom(U.data(), U.size());
    nrs->scalar->o_solution("k").copyFrom(k.data(), k.size());
    nrs->scalar->o_solution("tau").copyFrom(tau.data(), tau.size());
  }

  if (REF_SPAN <= 0.0) {
    const dfloat zMin = platform->linAlg->min(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm());
    const dfloat zMax = platform->linAlg->max(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm());
    REF_SPAN = std::max<dfloat>(std::abs(zMax - zMin), 1.0e-12);
  }
  REF_AREA = std::max<dfloat>(REF_CHORD * REF_SPAN, 1.0e-12);

  initializeForceFile();

  RANSktau::setup(nrs->scalar->nameToIndex.find("k")->second, "KTAUSST+IDDES");

#ifdef NEKRS_ASCENT_ENABLED
  {
    o_qcriterion.resize(mesh->Nlocal);

    deviceMemory<dfloat> o_ux(nrs->fluid->o_solution("x"));
    deviceMemory<dfloat> o_uy(nrs->fluid->o_solution("y"));
    deviceMemory<dfloat> o_uz(nrs->fluid->o_solution("z"));
    nekAscent::addVariable("velocity", mesh, std::vector<deviceMemory<dfloat>>{o_ux, o_uy, o_uz});

    deviceMemory<dfloat> o_p(nrs->fluid->o_P.slice(0, nrs->fluid->fieldOffset));
    nekAscent::addVariable("pressure", mesh, std::vector<deviceMemory<dfloat>>{o_p});

    nekAscent::addVariable("Qcriterion", mesh, std::vector<deviceMemory<dfloat>>{o_qcriterion});

    const int Nviz = mesh->N;
    const auto uniform = false;
    nekAscent::setup(mesh, "ascent.yaml", Nviz, uniform);
  }
#endif
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (nrs->timeStepConverged && (tstep % FORCE_WRITE_EVERY == 0)) {
    writeAeroForces(time, tstep);
  }

#ifdef NEKRS_ASCENT_ENABLED
  if (ASCENT_YAML_EVERY > 0 && nrs->timeStepConverged && tstep > 0 && (tstep % ASCENT_YAML_EVERY == 0)) {
    nrs->Qcriterion(o_qcriterion);
    nekAscent::run(time, tstep);
  }

  if (nrs->lastStep) {
    nekAscent::finalize();
  }
#endif
}
